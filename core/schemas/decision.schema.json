{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-workflow-template.invalid/schemas/decision.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
    },
    "choice": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "responsible": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decided_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
      }
    },
    "revisit_when": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "choice",
    "rationale",
    "responsible",
    "decided_at"
  ],
  "additionalProperties": false
}
