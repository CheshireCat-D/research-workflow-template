{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-workflow-template.invalid/schemas/project.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "interest": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "disciplines": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "entry_activity": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "workflow_mode": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "deliverable": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "venue": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "contribution_benchmarks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "kind",
        "language",
        "venue",
        "contribution_benchmarks"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "deadline": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "budget": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "available_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "deadline",
        "budget",
        "available_capabilities"
      ],
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "applicability": {
          "type": "string",
          "enum": [
            "unknown",
            "applicable",
            "not-applicable"
          ]
        },
        "relevant_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "applicability",
        "relevant_requirements"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "title",
    "interest",
    "disciplines",
    "methods",
    "entry_activity",
    "workflow_mode",
    "deliverable",
    "resources",
    "governance"
  ],
  "additionalProperties": false
}
