{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-workflow-template.invalid/schemas/evidence.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "location": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "extensions": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "external"
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "access_note": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "extensions": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "locator",
            "access_note"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "controlled"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "access_note": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "extensions": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "reference",
            "access_note"
          ],
          "additionalProperties": false
        }
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
      }
    },
    "limitations": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "type",
    "description",
    "provenance",
    "location"
  ],
  "additionalProperties": false
}
