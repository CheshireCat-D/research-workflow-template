{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-workflow-template.invalid/schemas/statement.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "type": {
      "type": "string",
      "enum": [
        "question",
        "formal",
        "empirical",
        "interpretive",
        "normative",
        "design"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "work_status": {
      "type": "string",
      "enum": [
        "draft",
        "in-progress",
        "reviewed",
        "archived"
      ]
    },
    "use": {
      "type": "string",
      "enum": [
        "included",
        "background",
        "excluded"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
      }
    },
    "assessment": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-assessed",
            "supported-in-scope",
            "mixed",
            "challenged",
            "insufficient",
            "not-applicable"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "scope",
        "rationale",
        "reviewer"
      ],
      "additionalProperties": false
    },
    "formal_verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-applicable",
            "not-started",
            "partial",
            "complete-in-scope"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "scope",
        "tool"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "text",
    "type",
    "scope"
  ],
  "additionalProperties": false
}
