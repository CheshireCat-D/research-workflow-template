{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-workflow-template.invalid/schemas/activity.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in-progress",
        "done",
        "failed",
        "skipped"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:source|statement|evidence|relation|activity|decision|artifact|method-binding):[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:source|statement|evidence|relation|activity|decision|artifact|method-binding):[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
      }
    },
    "note": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "title",
    "status"
  ],
  "additionalProperties": false
}
