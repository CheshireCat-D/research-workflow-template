{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-workflow-template.invalid/schemas/artifact.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:source|statement|evidence|relation|activity|decision|artifact|method-binding):[A-Za-z][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
      }
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "type",
    "description",
    "path"
  ],
  "additionalProperties": false
}
